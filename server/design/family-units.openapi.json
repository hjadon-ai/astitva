          },
          "429": {
            "description": "Persistent invitation quota exceeded"
          }
        }
      },
      "post": {
        "tags": [
          "Family"
        ],
        "summary": "Record an exact-email relationship request; generic receipt",
        "parameters": [],
        "responses": {
          "202": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid shape or fields"
          },
          "401": {
            "description": "Session required"
          },
          "403": {
            "description": "Wrong role, unverified, disabled feature or origin"
          },
          "404": {
            "description": "Absent or unauthorized record"
          },
          "409": {
            "description": "Stale revision, invalid graph, unsafe references or transactions unavailable"
          },
          "429": {
            "description": "Persistent invitation quota exceeded"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "sourceUnitId",
                  "targetEmail",
                  "relationship",
                  "expectedRevision",
                  "idempotencyKey"
                ],
                "properties": {
                  "sourceUnitId": {
                    "type": "string",
                    "pattern": "^[a-fA-F0-9]{24}$"
                  },
                  "targetEmail": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 254
                  },
                  "relationship": {
                    "type": "string",
                    "enum": [
                      "father",
                      "mother",
                      "parent",
                      "brother",
                      "sister",
                      "sibling",
                      "husband",
                      "wife",
                      "partner",
                      "son",
                      "daughter",
                      "child"
                    ]
                  },
                  "existingPersonId": {
                    "type": "string",
                    "pattern": "^[a-fA-F0-9]{24}$"
                  },
                  "inviteToRegister": {
                    "type": "boolean"
                  },
                  "expectedRevision": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "idempotencyKey": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80,
                    "description": "Required for inviteToRegister when no existingPersonId; creates a NON_USER before invitation."
                  },
                  "findMember": {
                    "type": "boolean"
                  },
                  "requestedRole": {
                    "type": "string",
                    "enum": [
                      "READONLY",
                      "EDITOR",
                      "ADMIN"
                    ],
                    "default": "READONLY"
                  }
                }
              }
            }
          }
        },
        "description": " findMember=true resolves exact email internally and invites to register only if absent; response stays generic. requestedRole is READONLY, EDITOR or ADMIN, defaults READONLY and activates only after consent and approval; elevated role requires initiating ADMIN at completion. Duplicate father/mother relationships return 409; one father and one mother per person."
      }
    },
