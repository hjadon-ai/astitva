          }
        },
        "description": "Preview removal for another linked or NON_USER member; ADMIN only."
      }
    },
    "/api/family/requests": {
      "get": {
        "tags": [
          "Family"
        ],
        "summary": "List latest 100 authorized requests",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid shape or fields"
          },
          "401": {
            "description": "Session required"
          },
          "403": {
            "description": "Wrong role, unverified, disabled feature or origin"
          },
          "404": {
