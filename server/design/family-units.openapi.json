{
  "openapi": "3.0.3",
  "info": {
    "title": "Astitva Shared Family Units (F035)",
    "version": "1.0.0",
    "description": "Verified sessions and enabled Family access. Local cookie mutations also require an approved Origin. Exact email requests never return account-existence confirmation. Two sends per sender/recipient/UTC day; seven-day expiry. Writes require replica-set transactions. Legacy records are not automatically converted."
  },
  "paths": {
    "/api/family/units": {
      "get": {
        "tags": [
          "Family"
        ],
        "summary": "List authorized normalized units and transaction capability",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid shape or fields"
          },
          "401": {
            "description": "Session required"
          },
          "403": {
            "description": "Wrong role, unverified, disabled feature or origin"
          },
          "404": {
            "description": "Absent or unauthorized record"
          },
          "409": {
            "description": "Stale revision, invalid graph, unsafe references or transactions unavailable"
          },
          "429": {
            "description": "Persistent invitation quota exceeded"
          }
        }
      },
      "post": {
        "tags": [
          "Family"
        ],
        "summary": "Establish a unit through a relationship context",
        "parameters": [],
        "responses": {
          "201": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid shape or fields"
          },
          "401": {
            "description": "Session required"
          },
          "403": {
            "description": "Wrong role, unverified, disabled feature or origin"
          },
          "404": {
            "description": "Absent or unauthorized record"
          },
          "409": {
            "description": "Stale revision, invalid graph, unsafe references or transactions unavailable"
          },
          "429": {
            "description": "Persistent invitation quota exceeded"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "relationship"
                ],
                "properties": {
                  "relationship": {
                    "type": "string",
                    "enum": [
                      "father",
                      "mother",
                      "parent",
                      "brother",
                      "sister",
                      "sibling",
                      "husband",
                      "wife",
                      "partner",
                      "son",
                      "daughter",
                      "child"
                    ]
                  }
                }
              }
            }
          }
        },
        "description": " Duplicate father/mother relationships return 409; one father and one mother per person."
      }
    },
