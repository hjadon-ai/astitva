    "/api/family/units/{unitId}/people": {
      "post": {
        "tags": [
          "Family"
        ],
        "summary": "Add explicit NON_USER without invitation or account",
        "parameters": [
          {
            "name": "unitId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{24}$"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid shape or fields"
          },
          "401": {
            "description": "Session required"
          },
          "403": {
            "description": "Wrong role, unverified, disabled feature or origin"
          },
          "404": {
            "description": "Absent or unauthorized record"
          },
          "409": {
            "description": "Stale revision, invalid graph, unsafe references or transactions unavailable"
          },
          "429": {
            "description": "Persistent invitation quota exceeded"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "kind",
                  "relationship",
                  "expectedRevision"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "NON_USER"
                    ]
                  },
                  "relationship": {
                    "type": "string",
                    "enum": [
                      "father",
                      "mother",
                      "parent",
                      "brother",
                      "sister",
                      "sibling",
                      "husband",
                      "wife",
                      "partner",
                      "son",
                      "daughter",
                      "child"
                    ]
                  },
                  "expectedRevision": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "description": " Duplicate father/mother relationships return 409; one father and one mother per person."
      }
    },
    "/api/family/units/{unitId}/people/{personId}": {
      "patch": {
        "tags": [
          "Family"
        ],
        "summary": "Update authorized unit details or ADMIN role",
        "parameters": [
          {
            "name": "unitId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{24}$"
            }
          },
          {
            "name": "personId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{24}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid shape or fields"
          },
          "401": {
            "description": "Session required"
          },
          "403": {
            "description": "Wrong role, unverified, disabled feature or origin"
          },
          "404": {
            "description": "Absent or unauthorized record"
          },
          "409": {
            "description": "Stale revision, invalid graph, unsafe references or transactions unavailable"
          },
          "429": {
            "description": "Persistent invitation quota exceeded"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "expectedRevision"
                ],
                "properties": {
                  "expectedRevision": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "ADMIN",
                      "EDITOR",
                      "READONLY"
                    ]
                  },
                  "name": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "details": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "preferredName": {
                        "type": "string",
                        "nullable": true,
                        "maxLength": 80
                      },
                      "birthDate": {
                        "type": "string",
                        "nullable": true,
                        "format": "date"
                      },
                      "note": {
                        "type": "string",
                        "nullable": true,
                        "maxLength": 1000
                      }
                    }
                  },
                  "relationship": {
                    "type": "string",
                    "enum": [
                      "father",
                      "mother",
                      "brother",
                      "sister",
                      "husband",
                      "wife",
                      "son",
                      "daughter"
                    ]
                  }
                }
              }
            }
          }
        },
        "description": " ADMIN/EDITOR may send relationship to correct an existing direct edge in the same circle. Revision checking and graph validation apply. Linked/multi-unit gender corrections, pending requests and dependent changes return 409. Duplicate father/mother relationships return 409; one father and one mother per person. Self birthDate edits update a canonical person birth date across active unit cards; notes remain unit-specific."
      },
      "delete": {
        "tags": [
          "Family"
        ],
        "summary": "ADMIN removes unit membership after explicit reference handling",
        "parameters": [
          {
            "name": "unitId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{24}$"
            }
          },
          {
            "name": "personId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{24}$"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid shape or fields"
          },
          "401": {
            "description": "Session required"
          },
          "403": {
            "description": "Wrong role, unverified, disabled feature or origin"
          },
          "404": {
            "description": "Absent or unauthorized record"
          },
          "409": {
            "description": "Stale revision, invalid graph, unsafe references or transactions unavailable"
          },
          "429": {
            "description": "Persistent invitation quota exceeded"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "expectedRevision",
                  "confirmation",
                  "confirmDetachRelationships"
                ],
                "properties": {
                  "expectedRevision": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "confirmation": {
                    "type": "boolean",
                    "enum": [
                      true
                    ]
                  },
                  "confirmDetachRelationships": {
                    "type": "boolean",
                    "enum": [
                      true
                    ]
                  }
                }
              }
            }
          }
        },
        "description": "ADMIN removal of another linked or NON_USER membership only; preserves accounts/private data/other units, revokes affected unit grants, detaches edges and requires revision and explicit confirmation. Self and pending references are blocked."
      }
    },
