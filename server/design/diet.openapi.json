    "/api/diet/library-meals": {
      "get": {
        "tags": [
          "Diet"
        ],
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "summary": "List, search, and filter personal library meals",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 120
            }
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "breakfast",
                "lunch",
                "dinner",
                "snack"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Library meals",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "meals",
                    "hasMore"
                  ],
                  "properties": {
                    "meals": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/LibraryMeal"
                      }
                    },
                    "hasMore": {
                      "type": "boolean"
                    }
