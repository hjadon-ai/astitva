    "/api/diet/library-meals/import": {
      "post": {
        "tags": [
          "Diet"
        ],
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "summary": "Revalidate and import selected preview rows as one all-or-none operation",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "rows"
                ],
                "properties": {
                  "rows": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 500,
                    "items": {
                      "$ref": "#/components/schemas/CsvRow"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Selected meals imported",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "importedCount",
                    "meals"
                  ],
                  "properties": {
                    "importedCount": {
                      "type": "integer"
                    },
                    "meals": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/LibraryMeal"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Request validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
