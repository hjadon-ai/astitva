    },
    "/api/chat/conversations/{id}/alias": {
      "patch": {
        "tags": [
          "Anonymous Chat"
        ],
        "summary": "Change my alias",
        "description": "Requires a verified signed-in account. Message reads/writes and alias changes also require X-Chat-Unlock. Invitations are single-use and expire after 24 hours. Deletion affects both participants.",
        "responses": {
          "200": {
            "description": "Success"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Not authorized or PIN locked"
          },
          "404": {
            "description": "Not found"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Chat-Unlock",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Short-lived token from unlock; required for message and alias operations."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "alias"
                ],
                "properties": {
                  "alias": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/chat/conversations/{id}/messages": {
      "get": {
        "tags": [
          "Anonymous Chat"
        ],
        "summary": "Read messages after unlock",
        "description": "Requires a verified signed-in account. Message reads/writes and alias changes also require X-Chat-Unlock. Invitations are single-use and expire after 24 hours. Deletion affects both participants.",
        "responses": {
          "200": {
            "description": "Success"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Not authorized or PIN locked"
          },
          "404": {
            "description": "Not found"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Chat-Unlock",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Short-lived token from unlock; required for message and alias operations."
          }
        ]
      },
      "post": {
        "tags": [
          "Anonymous Chat"
        ],
        "summary": "Send a message after unlock",
        "description": "Requires a verified signed-in account. Message reads/writes and alias changes also require X-Chat-Unlock. Invitations are single-use and expire after 24 hours. Deletion affects both participants.",
        "responses": {
          "200": {
            "description": "Success"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Not authorized or PIN locked"
          },
          "404": {
            "description": "Not found"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Chat-Unlock",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Short-lived token from unlock; required for message and alias operations."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "text"
                ],
                "properties": {
                  "text": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/chat/conversations/{id}": {
      "delete": {
        "tags": [
          "Anonymous Chat"
        ],
        "summary": "Delete a conversation for both participants",
        "description": "Requires a verified signed-in account. Message reads/writes and alias changes also require X-Chat-Unlock. Invitations are single-use and expire after 24 hours. Deletion affects both participants.",
        "responses": {
          "200": {
            "description": "Success"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Not authorized or PIN locked"
          },
