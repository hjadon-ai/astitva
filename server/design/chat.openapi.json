{
  "paths": {
    "/api/chat/invitations": {
      "post": {
        "tags": [
          "Anonymous Chat"
        ],
        "summary": "Create an invitation URL",
        "description": "Requires a verified signed-in account. Message reads/writes and alias changes also require X-Chat-Unlock. Invitations are single-use and expire after 24 hours. Deletion affects both participants.",
        "responses": {
          "200": {
            "description": "Success"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Not authorized or PIN locked"
          },
          "404": {
            "description": "Not found"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "alias"
                ],
                "properties": {
                  "alias": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Anonymous Chat"
        ],
        "summary": "List pending invitations",
        "description": "Requires a verified signed-in account. Message reads/writes and alias changes also require X-Chat-Unlock. Invitations are single-use and expire after 24 hours. Deletion affects both participants.",
        "responses": {
          "200": {
            "description": "Success"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Not authorized or PIN locked"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
