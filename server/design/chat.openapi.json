    },
    "/api/chat/conversations": {
      "get": {
        "tags": [
          "Anonymous Chat"
        ],
        "summary": "List conversations",
        "description": "Returns aliases, PIN state and participant-private unreadCount (received messages after saved read cursor); null if Firestore is not configured. No message previews. Poll at most every 30 seconds while visible.",
        "responses": {
          "200": {
            "description": "Success"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Not authorized or PIN locked"
          },
          "404": {
            "description": "Not found"
          }
        }
      },
      "delete": {
        "tags": [
          "Anonymous Chat"
        ],
        "summary": "Delete all my conversations",
        "description": "Requires a verified signed-in account. Message reads/writes and alias changes also require X-Chat-Unlock. Invitations are single-use and expire after 24 hours. Deletion affects both participants.",
        "responses": {
          "200": {
            "description": "Success"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Not authorized or PIN locked"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/api/chat/conversations/{id}/pin": {
      "post": {
        "tags": [
          "Anonymous Chat"
        ],
        "summary": "Set my conversation PIN",
        "description": "Requires a verified signed-in account. Message reads/writes and alias changes also require X-Chat-Unlock. Invitations are single-use and expire after 24 hours. Deletion affects both participants.",
        "responses": {
          "200": {
            "description": "Success"
          },
          "401": {
