{
  "openapi": "3.0.3",
  "info": {
    "title": "Astitva Family Social API (F023)",
    "version": "1.0.0",
    "description": "Same session/origin policy as Family APIs; accepted membership + post audience on every operation. Selected recipients retain account identity after re-entry. No notifications."
  },
  "paths": {
    "/api/family/{familyId}/posts": {
      "get": {
        "tags": [
          "Family Social"
        ],
        "summary": "List visible chronological posts plus authorized pinned announcement",
        "parameters": [
          {
            "name": "familyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{24}$"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            }
          },
          {
            "name": "before",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Opaque cursor from previous response."
          }
        ],
        "responses": {
          "200": {
            "description": "posts/comments, nextCursor; posts also includes pinned. Post summaries: id, authorId/name, type, text, audience, recipientIds, timestamps, version, authorized photoUrl, reactionCount/reacted, canEdit/canRemove/canPin/pinned. Images omitted."
          },
          "400": {
            "description": "Invalid payload/cursor/type/audience/photo signature"
          },
          "401": {
            "description": "Session required"
          },
          "403": {
            "description": "Verified enabled Family required, or author-only edit"
          },
          "404": {
            "description": "Not an accepted member, wrong family, invisible/removed post"
          },
          "409": {
            "description": "Stale edit or reaction capacity reached"
          },
          "413": {
            "description": "Photo exceeds 2 MiB"
          },
          "415": {
            "description": "Unsupported create-post content type"
          }
        }
      },
      "post": {
        "tags": [
          "Family Social"
        ],
        "summary": "Create update, milestone or announcement; READONLY may post",
        "parameters": [
          {
            "name": "familyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{24}$"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Success; authorization checked on every request"
          },
          "400": {
            "description": "Invalid payload/cursor/type/audience/photo signature"
          },
          "401": {
            "description": "Session required"
          },
          "403": {
            "description": "Verified enabled Family required, or author-only edit"
          },
          "404": {
            "description": "Not an accepted member, wrong family, invisible/removed post"
          },
          "409": {
            "description": "Stale edit or reaction capacity reached"
          },
          "413": {
            "description": "Photo exceeds 2 MiB"
          },
          "415": {
            "description": "Unsupported create-post content type"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PostInput"
              }
            },
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "payload"
                ],
                "additionalProperties": false,
                "properties": {
                  "payload": {
                    "type": "string",
                    "description": "JSON PostInput"
                  },
                  "photo": {
                    "type": "string",
                    "format": "binary",
                    "description": "JPEG/PNG up to 2 MiB, signature checked. Original metadata retained."
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/family/{familyId}/posts/{postId}": {
      "patch": {
        "tags": [
          "Family Social"
        ],
        "summary": "Author-only edit with optimistic version; photo retained",
        "parameters": [
          {
            "name": "familyId",
            "in": "path",
