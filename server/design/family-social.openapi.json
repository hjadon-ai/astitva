              "type": "string",
              "pattern": "^[a-fA-F0-9]{24}$"
            }
          },
          {
            "name": "postId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{24}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success; authorization checked on every request"
          },
          "400": {
            "description": "Invalid payload/cursor/type/audience/photo signature"
          },
          "401": {
            "description": "Session required"
          },
          "403": {
            "description": "Verified enabled Family required, or author-only edit"
          },
          "404": {
            "description": "Not an accepted member, wrong family, invisible/removed post"
          },
          "409": {
            "description": "Stale edit or reaction capacity reached"
          },
          "413": {
            "description": "Photo exceeds 2 MiB"
          },
          "415": {
            "description": "Unsupported create-post content type"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PostEdit"
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Family Social"
        ],
        "summary": "Any accepted viewer may remove post; clears photo and comments",
        "parameters": [
          {
            "name": "familyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{24}$"
            }
          },
          {
            "name": "postId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{24}$"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Success; authorization checked on every request"
          },
          "400": {
            "description": "Invalid payload/cursor/type/audience/photo signature"
          },
          "401": {
            "description": "Session required"
          },
          "403": {
            "description": "Verified enabled Family required, or author-only edit"
          },
          "404": {
            "description": "Not an accepted member, wrong family, invisible/removed post"
          },
          "409": {
            "description": "Stale edit or reaction capacity reached"
          },
          "413": {
            "description": "Photo exceeds 2 MiB"
          },
          "415": {
            "description": "Unsupported create-post content type"
          }
        }
      }
    },
    "/api/family/{familyId}/posts/{postId}/photo": {
      "get": {
        "tags": [
          "Family Social"
        ],
        "summary": "Authenticated authorized JPEG/PNG; never a public storage URL",
        "parameters": [
          {
            "name": "familyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{24}$"
            }
          },
          {
            "name": "postId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{24}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success; authorization checked on every request",
            "content": {
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/jpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "Invalid payload/cursor/type/audience/photo signature"
          },
          "401": {
            "description": "Session required"
          },
          "403": {
            "description": "Verified enabled Family required, or author-only edit"
          },
          "404": {
            "description": "Not an accepted member, wrong family, invisible/removed post"
          },
          "409": {
            "description": "Stale edit or reaction capacity reached"
          },
          "413": {
            "description": "Photo exceeds 2 MiB"
          },
          "415": {
            "description": "Unsupported create-post content type"
          }
        }
      }
    },
