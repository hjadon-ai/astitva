              "pattern": "^[a-fA-F0-9]{24}$"
            }
          },
          {
            "name": "postId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{24}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success; authorization checked on every request"
          },
          "400": {
            "description": "Invalid payload/cursor/type/audience/photo signature"
          },
          "401": {
            "description": "Session required"
          },
          "403": {
            "description": "Verified enabled Family required, or author-only edit"
          },
          "404": {
            "description": "Not an accepted member, wrong family, invisible/removed post"
          },
          "409": {
            "description": "Stale edit or reaction capacity reached"
          },
          "413": {
            "description": "Photo exceeds 2 MiB"
          },
          "415": {
            "description": "Unsupported create-post content type"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PinInput"
              }
            }
          }
        }
      }
    },
    "/api/family/{familyId}/posts/{postId}/reactions": {
      "post": {
        "tags": [
          "Family Social"
        ],
        "summary": "Idempotent caller Like; capped at 1000 unique users",
        "parameters": [
          {
            "name": "familyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{24}$"
            }
          },
          {
            "name": "postId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{24}$"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Success; authorization checked on every request"
          },
          "400": {
            "description": "Invalid payload/cursor/type/audience/photo signature"
          },
          "401": {
            "description": "Session required"
          },
          "403": {
            "description": "Verified enabled Family required, or author-only edit"
          },
          "404": {
            "description": "Not an accepted member, wrong family, invisible/removed post"
          },
          "409": {
            "description": "Stale edit or reaction capacity reached"
          },
          "413": {
            "description": "Photo exceeds 2 MiB"
          },
          "415": {
            "description": "Unsupported create-post content type"
          }
        }
      },
      "delete": {
        "tags": [
          "Family Social"
        ],
        "summary": "Remove caller Like",
        "parameters": [
          {
            "name": "familyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{24}$"
            }
          },
          {
            "name": "postId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{24}$"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Success; authorization checked on every request"
          },
          "400": {
            "description": "Invalid payload/cursor/type/audience/photo signature"
          },
          "401": {
            "description": "Session required"
          },
          "403": {
            "description": "Verified enabled Family required, or author-only edit"
          },
          "404": {
            "description": "Not an accepted member, wrong family, invisible/removed post"
          },
          "409": {
            "description": "Stale edit or reaction capacity reached"
          },
          "413": {
            "description": "Photo exceeds 2 MiB"
          },
          "415": {
            "description": "Unsupported create-post content type"
          }
        }
      }
    },
    "/api/family/{familyId}/posts/{postId}/comments": {
      "get": {
        "tags": [
          "Family Social"
        ],
        "summary": "Visible post comments, newest first",
        "parameters": [
          {
            "name": "familyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{24}$"
            }
          },
          {
            "name": "postId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{24}$"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            }
          },
          {
            "name": "before",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Opaque cursor from previous response."
          }
        ],
        "responses": {
          "200": {
            "description": "posts/comments, nextCursor; posts also includes pinned. Post summaries: id, authorId/name, type, text, audience, recipientIds, timestamps, version, authorized photoUrl, reactionCount/reacted, canEdit/canRemove/canPin/pinned. Images omitted."
          },
          "400": {
            "description": "Invalid payload/cursor/type/audience/photo signature"
          },
          "401": {
            "description": "Session required"
          },
          "403": {
            "description": "Verified enabled Family required, or author-only edit"
          },
          "404": {
            "description": "Not an accepted member, wrong family, invisible/removed post"
          },
          "409": {
            "description": "Stale edit or reaction capacity reached"
          },
          "413": {
            "description": "Photo exceeds 2 MiB"
          },
          "415": {
            "description": "Unsupported create-post content type"
          }
        }
      },
      "post": {
        "tags": [
          "Family Social"
        ],
        "summary": "Any accepted viewer including READONLY may comment",
        "parameters": [
          {
            "name": "familyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{24}$"
            }
          },
          {
            "name": "postId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{24}$"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Success; authorization checked on every request"
          },
          "400": {
            "description": "Invalid payload/cursor/type/audience/photo signature"
          },
          "401": {
            "description": "Session required"
          },
          "403": {
            "description": "Verified enabled Family required, or author-only edit"
          },
          "404": {
            "description": "Not an accepted member, wrong family, invisible/removed post"
          },
          "409": {
            "description": "Stale edit or reaction capacity reached"
          },
          "413": {
            "description": "Photo exceeds 2 MiB"
          },
          "415": {
            "description": "Unsupported create-post content type"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CommentInput"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PostInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "type",
          "audience"
        ],
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 2000
          },
          "type": {
            "type": "string",
            "enum": [
              "update",
              "milestone",
              "announcement"
            ]
          },
          "audience": {
            "type": "string",
            "enum": [
              "family",
              "selected"
            ]
          },
          "recipientIds": {
            "type": "array",
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{24}$"
            },
            "description": "Selected audience requires at least one other currently accepted user; family requires empty array."
          }
        }
      },
      "CommentInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      },
      "PinInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pinned"
        ],
        "properties": {
          "pinned": {
            "type": "boolean"
          }
        }
      },
      "PostEdit": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "type",
          "audience",
          "version"
        ],
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 2000
          },
          "type": {
            "type": "string",
            "enum": [
              "update",
              "milestone",
              "announcement"
            ]
          },
          "audience": {
            "type": "string",
            "enum": [
              "family",
              "selected"
            ]
          },
          "recipientIds": {
            "type": "array",
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{24}$"
            },
            "description": "Selected audience requires at least one other currently accepted user; family requires empty array."
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
