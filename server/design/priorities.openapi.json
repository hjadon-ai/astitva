{
  "openapi": "3.0.3",
  "info": {
    "title": "Astitva Daily Priorities API",
    "version": "1.0.0",
    "description": "F009. Session-derived ownership and verification apply to all requests. No userId input, future planning, carryover or day deletion. Atomic single-document capacity/field updates work on standalone localhost MongoDB. Refetch after writes; never automatically repeat an uncertain add."
  },
  "servers": [
    {
      "url": "http://localhost:3001"
    }
  ],
  "security": [
    {
      "sessionCookie": []
    }
  ],
  "paths": {
    "/api/priorities/days/{date}": {
      "parameters": [
        {
          "in": "header",
          "name": "X-Time-Zone",
          "required": true,
          "schema": {
            "type": "string"
          },
          "example": "America/Los_Angeles",
          "description": "Browser-declared IANA timezone. Server computes today in this zone; not an authorization boundary."
        },
        {
          "in": "path",
          "name": "date",
          "required": true,
          "schema": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "example": "2026-09-22",
          "description": "A real calendar date from 0001-01-01 through today in X-Time-Zone. Stored verbatim; GET never initializes it."
        }
      ],
      "get": {
        "tags": [
          "Daily Priorities"
        ],
        "operationId": "getPriorityDay",
        "summary": "Read the private day and actual-count progress",
        "responses": {
          "200": {
            "description": "Missing day is an empty array with zero progress; insertion order is retained.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Day"
                },
                "example": {
                  "date": "2026-09-22",
                  "priorities": [
                    {
                      "id": "507f1f77bcf86cd799439011",
                      "title": "Send proposal",
                      "completed": false
                    }
                  ],
                  "progress": {
                    "completed": 0,
                    "total": 1,
                    "limit": 3
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid real date, future date, missing/unsupported IANA timezone, malformed JSON, invalid body shape/type, unknown fields, blank/overlong/multiline title, or empty PATCH.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Use a valid YYYY-MM-DD date."
                }
              }
            }
          },
          "401": {
            "description": "Missing or expired session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Authentication required."
                }
              }
            }
          },
          "403": {
            "description": "Account is not verified.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Email verification required."
                }
              }
            }
          },
          "500": {
            "description": "Unexpected storage/server failure; details are not exposed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "The server could not complete this request."
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "X-Astitva-Member",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{24}$"
            },
            "description": "F036 managed context: both headers required together; ADMIN/EDITOR and general feature access rechecked."
          },
          {
            "name": "X-Astitva-Family",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{24}$"
            },
            "description": "F036 managed context: both headers required together; ADMIN/EDITOR and general feature access rechecked."
          }
        ]
      }
    },
    "/api/priorities/days/{date}/priorities": {
      "parameters": [
        {
          "in": "header",
          "name": "X-Time-Zone",
          "required": true,
          "schema": {
            "type": "string"
          },
          "example": "America/Los_Angeles",
          "description": "Browser-declared IANA timezone. Server computes today in this zone; not an authorization boundary."
        },
        {
          "in": "path",
          "name": "date",
          "required": true,
          "schema": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "example": "2026-09-22",
          "description": "A real calendar date from 0001-01-01 through today in X-Time-Zone. Stored verbatim; GET never initializes it."
        }
      ],
      "post": {
        "tags": [
          "Daily Priorities"
        ],
        "operationId": "addPriority",
        "summary": "Add one of up to three priorities",
        "responses": {
          "201": {
            "description": "Generated ID and initial completed=false.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PriorityResponse"
                },
                "example": {
                  "priority": {
                    "id": "507f1f77bcf86cd799439011",
                    "title": "Send proposal",
                    "completed": false
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid real date, future date, missing/unsupported IANA timezone, malformed JSON, invalid body shape/type, unknown fields, blank/overlong/multiline title, or empty PATCH.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Use a valid YYYY-MM-DD date."
                }
              }
            }
          },
          "401": {
            "description": "Missing or expired session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Authentication required."
                }
              }
            }
          },
          "403": {
            "description": "Account is not verified.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Email verification required."
                }
              }
            }
          },
          "500": {
            "description": "Unexpected storage/server failure; details are not exposed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "The server could not complete this request."
                }
              }
            }
          },
          "409": {
            "description": "Three slots occupied, including completed items and concurrent adds. Nothing inserted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "This date already has three priorities."
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddPriority"
              },
              "example": {
                "title": "Send proposal"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "X-Astitva-Member",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{24}$"
            },
            "description": "F036 managed context: both headers required together; ADMIN/EDITOR and general feature access rechecked."
          },
          {
            "name": "X-Astitva-Family",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{24}$"
            },
            "description": "F036 managed context: both headers required together; ADMIN/EDITOR and general feature access rechecked."
          }
        ]
      }
    },
    "/api/priorities/days/{date}/priorities/{priorityId}": {
      "parameters": [
        {
          "in": "header",
          "name": "X-Time-Zone",
          "required": true,
          "schema": {
            "type": "string"
          },
          "example": "America/Los_Angeles",
          "description": "Browser-declared IANA timezone. Server computes today in this zone; not an authorization boundary."
        },
        {
          "in": "path",
          "name": "date",
          "required": true,
          "schema": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "example": "2026-09-22",
          "description": "A real calendar date from 0001-01-01 through today in X-Time-Zone. Stored verbatim; GET never initializes it."
        },
        {
          "in": "path",
          "name": "priorityId",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{24}$"
          },
          "example": "507f1f77bcf86cd799439011"
        }
      ],
      "patch": {
        "tags": [
          "Daily Priorities"
        ],
        "operationId": "updatePriority",
        "summary": "Edit title, complete, or reopen a priority",
        "responses": {
          "200": {
            "description": "Only supplied fields changed. Completion does not reorder the list.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PriorityResponse"
                },
                "example": {
                  "priority": {
                    "id": "507f1f77bcf86cd799439011",
                    "title": "Send proposal",
                    "completed": true
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid real date, future date, missing/unsupported IANA timezone, malformed JSON, invalid body shape/type, unknown fields, blank/overlong/multiline title, or empty PATCH.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Use a valid YYYY-MM-DD date."
                }
              }
            }
          },
          "401": {
            "description": "Missing or expired session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Authentication required."
                }
              }
            }
          },
          "403": {
            "description": "Account is not verified.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Email verification required."
                }
              }
            }
          },
          "500": {
            "description": "Unexpected storage/server failure; details are not exposed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "The server could not complete this request."
                }
              }
            }
          },
          "404": {
            "description": "Malformed item ID or item absent from this owner/date, including another account\u2019s ID.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Priority not found."
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdatePriority"
              },
              "example": {
                "completed": true
              }
            }
          }
        },
        "parameters": [
          {
            "name": "X-Astitva-Member",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{24}$"
            },
            "description": "F036 managed context: both headers required together; ADMIN/EDITOR and general feature access rechecked."
          },
          {
            "name": "X-Astitva-Family",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{24}$"
            },
            "description": "F036 managed context: both headers required together; ADMIN/EDITOR and general feature access rechecked."
          }
        ]
      },
      "delete": {
        "tags": [
          "Daily Priorities"
        ],
        "operationId": "deletePriority",
        "summary": "Delete a priority and free its slot",
        "responses": {
          "204": {
            "description": "Deleted. Empty day retained; repeat delete returns 404."
          },
          "400": {
            "description": "Invalid real date, future date, missing/unsupported IANA timezone, malformed JSON, invalid body shape/type, unknown fields, blank/overlong/multiline title, or empty PATCH.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Use a valid YYYY-MM-DD date."
                }
              }
            }
          },
          "401": {
            "description": "Missing or expired session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Authentication required."
                }
              }
            }
          },
          "403": {
            "description": "Account is not verified.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Email verification required."
                }
              }
            }
          },
          "500": {
            "description": "Unexpected storage/server failure; details are not exposed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "The server could not complete this request."
                }
              }
            }
          },
          "404": {
            "description": "Malformed item ID or item absent from this owner/date, including another account\u2019s ID.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Priority not found."
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "X-Astitva-Member",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{24}$"
            },
            "description": "F036 managed context: both headers required together; ADMIN/EDITOR and general feature access rechecked."
          },
          {
            "name": "X-Astitva-Family",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{24}$"
            },
            "description": "F036 managed context: both headers required together; ADMIN/EDITOR and general feature access rechecked."
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "astitva_dev_session",
        "description": "Existing runtime convention: Dev uses astitva_dev_session; Stage uses astitva_stage_session."
      }
    },
    "schemas": {
      "Priority": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "completed"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{24}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[^\\r\\n\\u2028\\u2029]+$",
            "description": "Trimmed before length validation. Length uses JavaScript UTF-16 string units; line breaks are rejected even at the edges. Duplicate titles allowed."
          },
          "completed": {
            "type": "boolean"
          }
        }
      },
      "PriorityResponse": {
        "type": "object",
        "required": [
          "priority"
        ],
        "properties": {
          "priority": {
            "$ref": "#/components/schemas/Priority"
          }
        }
      },
      "AddPriority": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[^\\r\\n\\u2028\\u2029]+$",
            "description": "Trimmed before length validation. Length uses JavaScript UTF-16 string units; line breaks are rejected even at the edges. Duplicate titles allowed."
          }
        }
      },
      "UpdatePriority": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[^\\r\\n\\u2028\\u2029]+$",
            "description": "Trimmed before length validation. Length uses JavaScript UTF-16 string units; line breaks are rejected even at the edges. Duplicate titles allowed."
          },
          "completed": {
            "type": "boolean"
          }
        }
      },
      "Day": {
        "type": "object",
        "required": [
          "date",
          "priorities",
          "progress"
        ],
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "priorities": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "$ref": "#/components/schemas/Priority"
            }
          },
          "progress": {
            "type": "object",
            "required": [
              "completed",
              "total",
              "limit"
            ],
            "properties": {
              "completed": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3
              },
              "total": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3
              },
              "limit": {
                "type": "integer",
                "enum": [
                  3
                ]
              }
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      }
    }
  }
}
