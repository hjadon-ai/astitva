{
  "openapi": "3.0.3",
  "info": {
    "title": "F037 named meal libraries",
    "version": "1.0.0",
    "description": "Verified Diet users. Revision-controlled drafts; explicit read-only references; immutable Admin-approved public snapshots. CSV uses existing F008 schema. 1 MB/500 rows. No automatic AI invocation. Library reads never expose owner email; owner-only sharedWith may include recipient emails. POST migration retains legacy source records. Managed callers may manage their own person-owned library, but cannot distribute."
  },
  "paths": {
    "/api/diet/libraries": {
      "get": {
        "summary": "List accessible libraries",
        "tags": [
          "Meal Libraries"
        ],
        "security": [
          {
            "sessionCookie": []
          },
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "scope",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "mine",
                "public"
              ],
              "default": "mine"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success (library, libraries, saved or shared)"
          },
          "400": {
            "description": "Invalid fields/CSV"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Owner/Admin or managed distribution denied"
          },
          "404": {
            "description": "Unavailable or inaccessible"
          },
          "409": {
            "description": "Stale revision, duplicate or review lock"
          }
        }
      },
      "post": {
        "summary": "Create independent library",
        "tags": [
          "Meal Libraries"
        ],
        "security": [
          {
            "sessionCookie": []
          },
          {
            "bearerAuth": []
          }
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Success (library, libraries, saved or shared)"
          },
          "400": {
            "description": "Invalid fields/CSV"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Owner/Admin or managed distribution denied"
          },
          "404": {
            "description": "Unavailable or inaccessible"
          },
          "409": {
            "description": "Stale revision, duplicate or review lock"
          },
          "201": {
            "description": "Created library or daily meal snapshot"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "nutritionSource": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  },
                  "rows": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    },
                    "minItems": 1,
                    "maxItems": 500,
                    "description": "Optional selected normalized F008 preview rows with sourceRowNumber and CSV headers. Omit to create an empty library."
                  }
                }
              },
              "example": {
                "name": "Everyday meals",
                "nutritionSource": "AI estimates",
                "description": "",
                "tags": []
              }
            }
          }
        }
      }
    },
