{
  "openapi": "3.1.0",
  "info": {
    "title": "Astitva Diet MCP",
    "version": "1.1.0",
    "description": "See diet-mcp.md for transport, scopes, collection design and limits. OAuth protocol calls are cookie-free (browser GET /authorize may carry ignored cookies); application APIs retain session and origin protections. SDK validates OAuth protocol bodies; token and revoke use application/x-www-form-urlencoded."
  },
  "paths": {
    "/mcp": {
      "post": {
        "summary": "Stateless Streamable HTTP MCP; five read-only Diet tools",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Access denied"
          },
          "429": {
            "description": "Rate limited"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "jsonrpc",
                  "method"
                ],
                "properties": {
                  "jsonrpc": {
                    "const": "2.0"
                  },
                  "id": {},
                  "method": {
                    "type": "string"
                  },
                  "params": {
                    "type": "object"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/.well-known/oauth-authorization-server": {
      "get": {
        "summary": "OAuth discovery",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Access denied"
          },
          "429": {
            "description": "Rate limited"
          }
        }
      }
    },
    "/.well-known/oauth-protected-resource/mcp": {
      "get": {
        "summary": "Protected resource discovery",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Access denied"
          },
          "429": {
            "description": "Rate limited"
          }
        }
      }
    },
    "/register": {
      "post": {
        "summary": "Register a public PKCE client",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Access denied"
          },
          "429": {
            "description": "Rate limited"
          }
        }
      }
    },
    "/authorize": {
      "get": {
        "summary": "Start authorization; redirects to Astitva consent",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Access denied"
          },
          "429": {
            "description": "Rate limited"
          }
        }
      }
    },
    "/token": {
      "post": {
        "summary": "Exchange code or rotate refresh token (form encoded)",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Access denied"
          },
          "429": {
            "description": "Rate limited"
          }
        }
      }
    },
    "/revoke": {
      "post": {
        "summary": "Revoke an OAuth token (form encoded)",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Access denied"
          },
          "429": {
            "description": "Rate limited"
          }
        }
      }
    },
    "/api/mcp/connections": {
      "get": {
        "summary": "List up to 100 active connections for the signed-in Diet user; hasMore reports truncation",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Access denied"
          },
          "429": {
            "description": "Rate limited"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/mcp/connections/{id}": {
      "delete": {
        "summary": "Revoke an owned connection; returns 204",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Access denied"
          },
          "429": {
            "description": "Rate limited"
          },
          "204": {
            "description": "Revoked"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ]
    },
    "/api/mcp/consent/{ticket}": {
      "get": {
        "summary": "Read pending consent details for a verified Diet user",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Access denied"
          },
          "429": {
            "description": "Rate limited"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "post": {
        "summary": "Allow or deny a pending request; returns redirectUrl",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Access denied"
          },
          "429": {
            "description": "Rate limited"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "allow"
                ],
                "additionalProperties": false,
                "properties": {
                  "allow": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      },
      "parameters": [
        {
          "name": "ticket",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      ]
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
