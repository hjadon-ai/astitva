ASTITVA_ENV=production
MONGODB_URL=mongodb+srv://APP_USER:APP_PASSWORD@CLUSTER.mongodb.net/astitva_prod?retryWrites=true&w=majority
WEB_URL=https://PROJECT_ID.web.app
CORS_ORIGINS=https://PROJECT_ID.web.app
SESSION_COOKIE_NAME=astitva_prod_session
INVITED_EMAILS=owner@example.com
PLAID_ENABLED=false
PLAID_ENV=production
# Add PLAID_CLIENT_ID, PLAID_SECRET, PLAID_REDIRECT_URI, and FINANCE_TOKEN_ENCRYPTION_KEY only when enabling Finance.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-address@gmail.com
SMTP_PASSWORD=replace-with-google-app-password
EMAIL_FROM=Astitva <your-address@gmail.com>
