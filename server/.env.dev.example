ASTITVA_ENV=dev
PORT=3001
MONGODB_URL=mongodb://127.0.0.1:27017/astitva
WEB_URL=http://localhost:3000
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
# SMTP_USER=your-address@gmail.com, SMTP_PASSWORD=your-google-app-password,
# EMAIL_FROM=Astitva <your-address@gmail.com>
EMAIL_FROM=Astitva <no-reply@astitva.local>
PLAID_ENV=sandbox
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-sandbox-secret
FINANCE_TOKEN_ENCRYPTION_KEY=replace-with-a-64-character-hex-key

# Comma-separated verified admin emails; empty disables admin access.
ADMIN_EMAILS=
